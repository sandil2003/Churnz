# Database Configuration (matches docker-compose.yml port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/churn_db

# MLflow Tracking Server (matches docker-compose.yml port 5001)
# Note: If running without Docker, can be set to a local directory: file:./mlruns
MLFLOW_TRACKING_URI=http://localhost:5001

# Model Artifact Path (fallback if MLflow server is offline)
MODEL_PATH=models/champion_model.joblib

# Raw Dataset Path
DATA_RAW_PATH=data/raw/WA_Fn-UseC_-Telco-Customer-Churn.csv

# Application Settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
